{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    { "source": "/assets/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ],
  "redirects": [
    { "source": "/nha-sang-lap", "destination": "/gioi-thieu/#nha-sang-lap", "permanent": true },
    { "source": "/du-an", "destination": "/linh-vuc/#du-an", "permanent": true },
    { "source": "/thuong-hieu", "destination": "/linh-vuc/#thuong-hieu", "permanent": true }
  ]
}
